# Line endings: LF in the repository and in every checkout. A CRLF shebang breaks scripts.
* text=auto eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Generated files (contracts/README.md): regenerated with make contracts, never edited by hand.
contracts/openapi.yaml linguist-generated=true
frontend/src/app/shared/api.ts linguist-generated=true
